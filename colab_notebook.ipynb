if repositories:
    print(f"\n📊 Discovered {len(repositories)} repositories")
    
    # Create DataFrame for analysis
    df = create_repository_dataframe(repositories)
    
    # Display basic statistics
    print("\n📈 Basic Statistics:")
    print(f"Total repositories: {len(df)}")
    print(f"Average stars: {df['stars'].mean():.1f}")
    print(f"Average forks: {df['forks'].mean():.1f}")
    print(f"Unique languages: {df['language'].nunique()}")
    
    # Show top repositories
    print("\n🏆 Top 10 Repositories by Stars:")
    top_repos = df.nlargest(10, 'stars')[['name', 'stars', 'language']]
    print(top_repos.to_string(index=False))
    
    # Create visualizations
    print("\n📊 Creating visualizations...")
    visualize_repository_data(df)
    
    # Analyze a few repositories in detail
    print("\n🔍 Detailed Analysis of Top 3 Repositories:")
    top_3_repos = df.nlargest(3, 'stars')
    
    detailed_results = []
    for _, repo_row in top_3_repos.iterrows():
        repo_name = repo_row['full_name']
        repo_data = next((r for r in repositories if r['full_name'] == repo_name), None)
        
        if repo_data:
            analysis = await analyze_repository(repo_data)
            detailed_results.append(analysis)
            
            # Print key insights
            print(f"\n📋 {repo_name}:")
            if 'error' not in analysis:
                print(f"  Overall Score: {analysis['scores'].get('overall_score', 0):.2f}")
                print(f"  AI Relevance: {analysis['evaluation'].get('ai_relevance_score', 0):.2f}")
                print(f"  Top Category: {analysis['classifications'][0].get('category', 'Unknown') if analysis['classifications'] else 'Unknown'}")
            else:
                print(f"  Error: {analysis['error']}")
    
else:
    print("❌ No repositories discovered. Please check your GitHub token configuration.")

