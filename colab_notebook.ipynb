# =============================================================================
# CELL 8: Repository Discovery Function
# =============================================================================

@run_in_colab
async def discover_ai_repositories(queries=None, max_repos=20):
    """
    Discover AI repositories from GitHub
    
    Args:
        queries: List of search queries (default: AI-related queries)
        max_repos: Maximum number of repositories to discover
    
    Returns:
        List of repository data
    """
    if queries is None:
        queries = [
            "machine learning",
            "deep learning", 
            "artificial intelligence",
            "neural network"
        ]
    
    print(f"🔍 Discovering repositories for queries: {queries}")
    
    try:
        repositories = await discovery_engine.discover_ai_repositories(
            queries=queries,
            max_repos_per_query=max_repos // len(queries)
        )
        
        print(f"✅ Discovered {len(repositories)} repositories")
        return repositories
        
    except Exception as e:
        print(f"❌ Error discovering repositories: {e}")
        return []

# =============================================================================
# CELL 9: Repository Analysis Function
# =============================================================================

async def analyze_repository(repo_data):
    """
    Analyze a single repository
    
    Args:
        repo_data: Repository data from discovery
    
    Returns:
        Dictionary with analysis results
    """
    print(f"🔍 Analyzing repository: {repo_data.get('full_name', 'Unknown')}")
    
    try:
        # Perform evaluations
        evaluation = evaluator.evaluate_repository(repo_data)
        classifications = classifier.classify_repository(repo_data)
        scores = scorer.calculate_composite_score(repo_data)
        trend_analysis = trend_engine.analyze_repository_trends(repo_data)
        
        results = {
            'repository': repo_data.get('full_name'),
            'evaluation': evaluation,
            'classifications': classifications,
            'scores': scores,
            'trend_analysis': trend_analysis
        }
        
        print(f"✅ Analysis completed for {repo_data.get('full_name')}")
        return results
        
    except Exception as e:
        print(f"❌ Error analyzing repository: {e}")
        return {'error': str(e)}

# =============================================================================
# CELL 10: Data Visualization
# =============================================================================

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Set style for better plots
plt.style.use('default')
sns.set_palette("husl")

def create_repository_dataframe(repositories):
    """Create a pandas DataFrame from repository data"""
    data = []
    for repo in repositories:
        data.append({
            'name': repo.get('name', ''),
            'full_name': repo.get('full_name', ''),
            'stars': repo.get('stargazers_count', 0),
            'forks': repo.get('forks_count', 0),
            'language': repo.get('language', 'Unknown'),
            'created_at': repo.get('created_at', ''),
            'updated_at': repo.get('updated_at', ''),
            'open_issues': repo.get('open_issues_count', 0),
            'size': repo.get('size', 0)
        })
    
    return pd.DataFrame(data)

def visualize_repository_data(df):
    """Create visualizations for repository data"""
    if df.empty:
        print("No data to visualize")
        return
    
    # Create subplots
    fig, axes = plt.subplots(2, 2, figsize=(15, 12))
    fig.suptitle('Sovereign AI Arsenal - Repository Analysis', fontsize=16)
    
    # 1. Stars distribution
    axes[0, 0].hist(df['stars'], bins=20, alpha=0.7, color='skyblue')
    axes[0, 0].set_title('Stars Distribution')
    axes[0, 0].set_xlabel('Stars')
    axes[0, 0].set_ylabel('Frequency')
    
    # 2. Programming languages
    lang_counts = df['language'].value_counts().head(10)
    axes[0, 1].bar(range(len(lang_counts)), lang_counts.values, color='lightcoral')
    axes[0, 1].set_title('Top Programming Languages')
    axes[0, 1].set_xlabel('Language')
    axes[0, 1].set_ylabel('Count')
    axes[0, 1].set_xticks(range(len(lang_counts)))
    axes[0, 1].set_xticklabels(lang_counts.index, rotation=45, ha='right')
    
    # 3. Stars vs Forks scatter
    axes[1, 0].scatter(df['stars'], df['forks'], alpha=0.6, color='green')
    axes[1, 0].set_title('Stars vs Forks')
    axes[1, 0].set_xlabel('Stars')
    axes[1, 0].set_ylabel('Forks')
    
    # 4. Repository size distribution
    size_data = df[df['size'] > 0]['size']  # Only show repos with size > 0
    if not size_data.empty:
        axes[1, 1].hist(size_data, bins=15, alpha=0.7, color='orange')
        axes[1, 1].set_title('Repository Size Distribution')
        axes[1, 1].set_xlabel('Size (bytes)')
        axes[1, 1].set_ylabel('Frequency')
    else:
        axes[1, 1].text(0.5, 0.5, 'No size data available', 
                        ha='center', va='center', transform=axes[1, 1].transAxes)
        axes[1, 1].set_title('Repository Size Distribution')
    
    plt.tight_layout()
    plt.show()

