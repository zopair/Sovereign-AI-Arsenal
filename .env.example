# Copy to .env and replace both values with unique random secrets.
# Generate with: openssl rand -hex 32
DB_PASSWORD=replace-with-a-unique-random-64-character-hex-secret
GRAFANA_ADMIN_PASSWORD=replace-with-a-different-random-secret

# Optional integrations. Empty values keep the local core usable without paid APIs.
GITHUB_TOKEN=
OPENAI_API_KEY=

# Optional local binding/port overrides
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
POSTGRES_PORT=5432
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
CORS_ORIGINS=
