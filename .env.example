# Generate four DIFFERENT secrets with: openssl rand -hex 32
# Never commit the populated .env file.
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
API_AUTH_TOKEN=

# Optional integrations. Core local operation does not require paid API keys.
GITHUB_TOKEN=
OPENAI_API_KEY=

# Optional OpenAI-compatible inference providers.
# Add only providers for which you are authorized and whose current plan permits your use.
# Keep one credential per provider here; do not create extra accounts/keys to evade quotas.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=

# JSON array. Use current model IDs and endpoint URLs from each provider's official docs.
# Example shape:
# ZI_LLM_PROVIDERS=[{"name":"provider-a","base_url":"https://api.example.com/v1","api_key_env":"PROVIDER_A_API_KEY","model":"current-model-id","timeout_seconds":45,"cooldown_seconds":60}]
ZI_LLM_PROVIDERS=[]

# Optional local binding/port overrides
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
POSTGRES_PORT=5432
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
CORS_ORIGINS=
