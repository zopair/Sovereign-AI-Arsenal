# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/
__pycache__/
*.py[cod]
.venv/
venv/

# build artifacts
/.next/
/out/
/build
/dist/

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# logs and local state
*.log
local-*
.claude
.z-ai-config
test
prompt
/skills/

# Secrets: keep real env files out of Git, but allow the safe template.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
